+# Adreno 720, as found in the SM7550 (Snapdragon 7 Gen 3). Upstream has no entry for it, so
+# eglInitialize on Turnip fails outright with "device (chip_id = 43020000, gpu_id = 6720) is
+# unsupported" and every Zink-based renderer is unreachable on the phone.
+#
+# These were decoded from Adreno 720 blob command streams rather than copied from a730: the a7xx
+# gen1 parts differ from one another in exactly these registers, and a730's values are wrong here.
+a720_magic_regs = dict(
+        RB_DBG_ECO_CNTL = 0x00000000,
+        RB_DBG_ECO_CNTL_blit = 0x00000000,
+        RB_RBP_CNTL = 0x0,
+)
