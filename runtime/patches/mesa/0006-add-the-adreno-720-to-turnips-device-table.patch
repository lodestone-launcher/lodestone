+add_gpus([
+        GPUId(chip_id=0x43020000, name="FD720"),
+        GPUId(chip_id=0xffff43020000, name="FD720"), # Default no-speedbin fallback
+    ], A6xxGPUInfo(
+        CHIP.A7XX,
+        [a7xx_base, a7xx_gen1],
+        # Everything but num_ccu and the magic registers matches a730: the a7xx gen1 parts share a
+        # tiling and fiber layout, and only the shader core count and the per-GPU register tuning
+        # actually differ. num_ccu is the one value here with no second source — a730 and a725 have
+        # 4, a735 has 3, and 2 is what the blob traces imply for this smaller part. GMEM size is not
+        # guessed at all; KGSL reports it.
+        num_ccu = 2,
+        tile_align_w = 64,
+        tile_align_h = 32,
+        tile_max_w = 1024,
+        tile_max_h = 1024,
+        num_vsc_pipes = 32,
+        # Confirmed against the phone: the vendor driver reports maxComputeSharedMemorySize 32768.
+        cs_shared_mem_size = 32 * 1024,
+        wave_granularity = 2,
+        fibers_per_sp = 128 * 2 * 16,
+        highest_bank_bit = 16,
+        magic_regs = a720_magic_regs,
+        raw_magic_regs = a720_raw_magic_regs,
+    ))
