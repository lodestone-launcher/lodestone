+#include <system/window.h>
 
 #include "util/compiler.h"
 #include "util/libsync.h"
@@ -277,6 +278,7 @@ droid_create_surface(_EGLDisplay *disp, EGLint type, _EGLConfig *conf,
    struct dri2_egl_surface *dri2_surf;
    struct ANativeWindow *window = native_window;
    const struct dri_config *config;
+   bool connected = false;
 
    dri2_surf = calloc(1, sizeof *dri2_surf);
    if (!dri2_surf) {
@@ -295,6 +297,18 @@ droid_create_surface(_EGLDisplay *disp, EGLint type, _EGLConfig *conf,
       int buffer_count;
       int min_undequeued_buffers;
 
+      /* Behind Android's own libEGL this has already been done, by the
+       * eglCreateWindowSurface that dispatched here. Loaded directly by an
+       * application, nothing has claimed the window, and its BufferQueue
+       * answers every dequeueBuffer with NO_INIT until a producer API
+       * connects.
+       */
+      if (native_window_api_connect(window, NATIVE_WINDOW_API_EGL)) {
+         _eglError(EGL_BAD_NATIVE_WINDOW, "droid_create_surface");
+         goto cleanup_surface;
+      }
+      connected = true;
+
       format = ANativeWindow_getFormat(window);
