          _eglError(EGL_BAD_NATIVE_WINDOW, "droid_create_surface");
@@ -365,6 +379,8 @@ droid_create_surface(_EGLDisplay *disp, EGLint type, _EGLConfig *conf,
    return &dri2_surf->base;
 
 cleanup_surface:
+   if (connected)
+      native_window_api_disconnect(window, NATIVE_WINDOW_API_EGL);
    if (dri2_surf->color_buffers_count)
       free(dri2_surf->color_buffers);
    free(dri2_surf);
@@ -396,6 +412,7 @@ droid_destroy_surface(_EGLDisplay *disp, _EGLSurface *surf)
