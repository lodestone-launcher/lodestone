diff --git a/src/meson.build b/src/meson.build
index a4f8084..799ab06 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -177,4 +177,20 @@ if with_glx != 'disabled' and not with_glvnd
   )
 endif
 
+# Upstream only ever links libglapi_bridge — the desktop GL entry points — into libGL.so from the
+# GLX provider, and GLX is unbuildable on Android. Without a library that exports glGenVertexArrays
+# and friends there is nothing for LWJGL's `org.lwjgl.opengl.libname` to dlsym against, since it
+# resolves entry points by symbol lookup and not through eglGetProcAddress.
+if with_platform_android and with_opengl and with_dri
+  libgl = shared_library(
+    'GL',
+    [],
+    link_whole : [libglapi_bridge],
+    link_with : [libgallium_dri],
+    link_args : [ld_args_bsymbolic, ld_args_gc_sections],
+    dependencies : [dep_dl, dep_m, dep_thread],
+    install : true,
+  )
+endif
+
 subdir('tool')
