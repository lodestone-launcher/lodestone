local.properties

# Native build intermediates
app/.cxx/

# gl4es is produced by runtime/build-gl4es.sh, not checked in (9 MB of build output)
app/src/main/jniLibs/*/libgl4es.so

# The cross-built LWJGL natives come from runtime/build-lwjgl.sh, for the same reason. One
# directory per LWJGL release, because the generated JNI libraries bind only to the release they
# were generated from, and they are assets rather than jniLibs so that the sets can be told apart:
# the installer only extracts the top level of lib/<abi>/, and LWJGL loads them by their real names.
# A set also carries an lwjgl2/ subdirectory holding the OpenGL bindings again with their JNI
# symbols relocated, which is what the LWJGL 2 compatibility layer resolves against; same file name
# as the stock build, because the relocated Java side still asks for lwjgl_opengl.
app/src/main/assets/lwjgl/
# FreeType and OpenAL Soft come out of the same script. The freetype and openal bindings have no
# JNI library of their own — they go through libffi by symbol name — so one build of each serves
# every set and they stay in jniLibs.
app/src/main/jniLibs/*/libfreetype.so
app/src/main/jniLibs/*/libopenal.so

# The NDK's C++ runtime, copied in by the native build rather than written here.
app/src/main/jniLibs/*/libc++_shared.so
/out/

# Worktrees an agent session creates for itself; each is a clone of this repository.
.claude/worktrees/

# Control-button artwork. TouchControls resolves these by name at run time, so a checkout without
# them compiles and falls back to drawn plates. The set sitting here now is Bedrock's, copied in
# locally to judge the layout against real artwork before original artwork is made — Mojang's, not
# ours, and never committed: this app ships no Minecraft content.
app/src/main/res/drawable-nodpi/
