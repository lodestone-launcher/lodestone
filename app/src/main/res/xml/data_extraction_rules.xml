<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- The account store is encrypted with a key that never leaves this device's key store, so
             a copy restored anywhere else is undecryptable noise. Backing it up would only spread a
             credential around without ever being usable. -->
        <exclude domain="file" path="accounts.bin" />
        <!-- Versions, assets and Java runtimes are hundreds of megabytes that can be fetched
             again. -->
        <exclude domain="file" path="minecraft" />
    </cloud-backup>
    <device-transfer>
        <!-- Same reasoning: the key store entry does not transfer, so neither can the tokens. -->
        <exclude domain="file" path="accounts.bin" />
        <exclude domain="file" path="minecraft" />
    </device-transfer>
</data-extraction-rules>
