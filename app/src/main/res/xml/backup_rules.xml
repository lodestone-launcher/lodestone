<?xml version="1.0" encoding="utf-8"?><!--
   Applies to devices below API 31; @xml/data_extraction_rules covers the rest.
-->
<full-backup-content>
    <!-- The account store is encrypted with a key that never leaves this device's key store, so a
         copy restored anywhere else is undecryptable noise. Backing it up would only spread a
         credential around without ever being usable. -->
    <exclude domain="file" path="accounts.bin" />
    <!-- Versions, assets and Java runtimes are hundreds of megabytes that can be fetched again. -->
    <exclude domain="file" path="minecraft" />
</full-backup-content>
